{
  "rewrites": [{ "source": "/((?!assets/|icons/|config.js|sw.js|manifest.webmanifest).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
